# Pinned scanners. Local runs use these images; CI copies the binaries out of the same
# images, so both run identical bits. Digests MUST be multi-arch indexes (amd64 + arm64):
# refresh them with `make pin-scanner-images`, never from a local `podman inspect`, which can
# report the arm64-only manifest on a Mac and break the amd64 CI runner ("exec format error").
TRIVY_VERSION=0.76.2
TRIVY_IMG=docker.io/aquasec/trivy:0.76.2@sha256:8f6bb947dbc528902e11f2f5be52f7b519f6a39d5d148f41166f2040499768fb
GITLEAKS_VERSION=8.30.1
GITLEAKS_IMG=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
PIP_AUDIT_VERSION=2.10.1
BANDIT_VERSION=1.9.4
PYTHON_IMAGE=docker.io/library/python:3.14-slim
NODE_IMAGE=docker.io/library/node:24-alpine
GRYPE_VERSION=0.116.0
GRYPE_IMG=docker.io/anchore/grype:v0.116.0@sha256:fd4ab4d1042b522c896e73bdf09ab8bf384fa417df99d6dd0d6e1008c7e7c821
COSIGN_IMG=registry.access.redhat.com/hi/cosign@sha256:b093a3ec46fab423d25333ca1a9466ccf21799c94008eaf1b9fdbd23e7ee25a2
# Red Hat's signing key for Red Hat Hardened Images (see hummingbird-project.io docs)
# Red Hat release key 3 (from https://security.access.redhat.com/data/63405576.txt), kept in the
# repo so verification doesn't depend on downloading it on every run.
RH_SIGNING_KEY=scan/redhat-release-key-3.pub
HELM_IMG=docker.io/alpine/helm:4.3.1@sha256:e3f8d5c462d75470fbb1fce79ad5c20063657096d1f98c0fcea869e2600e2e5e
KUBECONFORM_IMG=ghcr.io/yannh/kubeconform:v0.8.0@sha256:faffaf43f95aa6425306e1ab8d6fcad72acb9049158f38e574c085ea1ec0f64e
