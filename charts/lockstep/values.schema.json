{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Lockstep chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "secretKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "driftSide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "addr": {"type": "string", "pattern": "^(https?://.+)?$"},
        "namespace": {"type": "string"},
        "mount": {"type": "string"},
        "prefix": {"type": "string"},
        "name": {"type": "string"},
        "role": {"type": "string"},
        "authMount": {"type": "string", "minLength": 1},
        "tokenSecret": {"$ref": "#/definitions/secretKey"}
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^(https?://.+)?$"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "cookieSecure": {
          "type": "boolean"
        }
      }
    },
    "vaults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://.+"
          },
          "browserUrl": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "writable": {
            "type": "boolean"
          },
          "allowDestroy": {
            "type": "boolean"
          },
          "approvals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "exportMode": {
            "type": "string",
            "enum": ["any", "encrypted", "off"]
          },
          "writePaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "denyPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "allowCustomConnections": {
      "type": "boolean"
    },
    "customAllowPrivate": {
      "type": "boolean"
    },
    "customUrlPatterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maxTreeSecrets": {
      "type": "integer",
      "minimum": 1
    },
    "allowDestroy": {
      "type": "boolean"
    },
    "readOnly": {
      "type": "boolean"
    },
    "policyApply": {
      "type": "string",
      "enum": ["on", "off"]
    },
    "auditReveals": {
      "type": "string",
      "enum": ["on", "off"]
    },
    "apiDocs": {
      "type": "string",
      "enum": ["on", "off"]
    },
    "userWrite": {
      "type": "string",
      "enum": ["on", "off"]
    },
    "allowClipboard": {
      "type": "boolean"
    },
    "plans": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {"type": "string"},
        "ttlHours": {"type": "integer", "minimum": 1, "maximum": 2160},
        "approvals": {"type": "integer", "minimum": 0, "maximum": 1},
        "signingKeySecret": {"$ref": "#/definitions/secretKey"},
        "trustedKeys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "key"],
            "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "tokenSecret": {"$ref": "#/definitions/secretKey"},
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string"},
            "labels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    },
    "driftCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "schedule": {"type": "string", "minLength": 1},
        "suspend": {"type": "boolean"},
        "left": {"$ref": "#/definitions/driftSide"},
        "right": {"$ref": "#/definitions/driftSide"},
        "profile": {"type": "string"},
        "baseline": {"type": "string"},
        "baselineConfigMap": {"$ref": "#/definitions/secretKey"},
        "failOn": {"enum": ["", "any", "new", "changed"]},
        "waivers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "owner", "reason", "expires"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "key": {"type": "string"},
              "owner": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "expires": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
            }
          }
        },
        "pushgateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {"type": "string", "pattern": "^(https?://.+)?$"},
            "job": {"type": "string", "minLength": 1}
          }
        },
        "extraArgs": {"type": "array", "items": {"type": "string"}},
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {"type": "boolean"},
            "name": {"type": "string"},
            "annotations": {"type": "object"}
          }
        },
        "concurrencyPolicy": {"enum": ["Allow", "Forbid", "Replace"]},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "successfulJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "failedJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "resources": {"type": "object"},
        "egress": {"type": "array"}
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {"enum": ["debug", "info", "warning", "error"]},
        "format": {"enum": ["text", "json"]}
      }
    },
    "exportMode": {
      "type": "string",
      "enum": ["any", "encrypted", "off"]
    },
    "exportRecipients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "recipients"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "recipients": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^age1"}}
        }
      }
    },
    "vaultTls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verify": {
          "type": "boolean"
        },
        "caBundle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configMap": {
              "type": "string"
            },
            "secret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "kubernetesAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mount": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountToken": {
          "enum": [
            "auto",
            true,
            false
          ]
        }
      }
    },
    "policyPatterns": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["layout", "policies"],
        "properties": {
          "name": {"type": "string"},
          "layout": {"type": "string", "minLength": 1},
          "values": {"type": "object"},
          "policies": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "rules"]}},
          "compare": {"type": "object"}
        }
      }
    },
    "policyProfiles": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "description": {"type": "string", "maxLength": 1000},
          "mappings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["left", "right"],
            "properties": {"left": {"type": "string", "minLength": 1}, "right": {"type": "string", "minLength": 1}}}},
          "rewrites": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["find"],
            "properties": {"find": {"type": "string", "minLength": 1}, "replace": {"type": "string"}}}},
          "ignore": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "configProfiles": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "description": {"type": "string", "maxLength": 1000},
          "mappings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["left", "right"],
            "properties": {"left": {"type": "string", "minLength": 1}, "right": {"type": "string", "minLength": 1}}}},
          "rewrites": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["find"],
            "properties": {"find": {"type": "string", "minLength": 1}, "replace": {"type": "string"}}}},
          "ignore": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "profiles": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "leftMount": {
            "type": "string"
          },
          "leftPrefix": {
            "type": "string"
          },
          "rightMount": {
            "type": "string"
          },
          "rightPrefix": {
            "type": "string"
          },
          "rules": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mappings": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "left",
                    "right"
                  ],
                  "properties": {
                    "left": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "right": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  }
                }
              },
              "ignoreKeys": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "path": {
                      "type": "string",
                      "maxLength": 512
                    }
                  }
                }
              },
              "ignorePaths": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "rewrites": {
                "description": "Words read as their counterpart in values before comparing, and when copying (left: test, right: dev). Whole words, case-sensitive.",
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "left",
                    "right"
                  ],
                  "properties": {
                    "left": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "right": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array"
        },
        "vaultEgress": {
          "type": "array"
        },
        "allowDns": {
          "type": "boolean"
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    }
  }
}
