{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getlockstep.cloud/schemas/lockstep-export-v1.json",
  "title": "Lockstep secret-engine export",
  "description": "A KV v2 secret engine exported by Lockstep, either as plain JSON with values or encrypted with a one-time key, a passphrase or age public keys. Plain exports hold secret values.",
  "oneOf": [
    {
      "$ref": "#/$defs/ExportDoc"
    },
    {
      "$ref": "#/$defs/EncryptedExport"
    }
  ],
  "$defs": {
    "ExportRules": {
      "description": "What was left out when exporting.",
      "properties": {
        "ignore_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Ignore Paths",
          "type": "array"
        },
        "ignore_keys": {
          "items": {
            "$ref": "#/$defs/IgnoreKey"
          },
          "maxItems": 200,
          "title": "Ignore Keys",
          "type": "array"
        }
      },
      "title": "ExportRules",
      "type": "object"
    },
    "ExportSecret": {
      "additionalProperties": false,
      "description": "A secret with its data, or a keep entry: a path with \"keep\": true and no data.",
      "oneOf": [
        {
          "properties": {
            "keep": {
              "const": false
            }
          },
          "required": [
            "data"
          ]
        },
        {
          "properties": {
            "keep": {
              "const": true
            },
            "data": {
              "maxProperties": 0
            }
          },
          "required": [
            "keep"
          ]
        }
      ],
      "properties": {
        "path": {
          "description": "Relative to source.prefix",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "updated": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated"
        },
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The secret's keys and values (not with keep)",
          "title": "Data"
        },
        "keep": {
          "default": false,
          "description": "Leave the target's secret at this path as it is, with no data: it's neither written nor deleted, even when an import deletes what isn't in the file",
          "title": "Keep",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "title": "ExportSecret",
      "type": "object"
    },
    "ExportSkipped": {
      "properties": {
        "ignored_paths": {
          "default": 0,
          "title": "Ignored Paths",
          "type": "integer"
        },
        "ignored_keys": {
          "default": 0,
          "title": "Ignored Keys",
          "type": "integer"
        },
        "unreadable": {
          "description": "Secrets that couldn't be read",
          "items": {
            "type": "string"
          },
          "title": "Unreadable",
          "type": "array"
        },
        "deleted": {
          "description": "Secrets whose latest version is deleted",
          "items": {
            "type": "string"
          },
          "title": "Deleted",
          "type": "array"
        },
        "denied_folders": {
          "description": "Folders that couldn't be listed",
          "items": {
            "type": "string"
          },
          "title": "Denied Folders",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "description": "True if the listing hit the size limit",
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "title": "ExportSkipped",
      "type": "object"
    },
    "ExportSource": {
      "properties": {
        "vault": {
          "description": "The connection's name when exported",
          "title": "Vault",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The Vault address (left out for preset connections)",
          "title": "Url"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "mount": {
          "title": "Mount",
          "type": "string"
        },
        "prefix": {
          "default": "",
          "description": "Paths below are relative to this prefix",
          "title": "Prefix",
          "type": "string"
        },
        "identity": {
          "default": "",
          "description": "Who exported it, as Vault reported them",
          "title": "Identity",
          "type": "string"
        }
      },
      "required": [
        "vault",
        "mount"
      ],
      "title": "ExportSource",
      "type": "object"
    },
    "IgnoreKey": {
      "properties": {
        "key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "path": {
          "default": "**",
          "maxLength": 512,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "title": "IgnoreKey",
      "type": "object"
    },
    "EncryptedSource": {
      "properties": {
        "vault": {
          "title": "Vault",
          "type": "string"
        },
        "mount": {
          "title": "Mount",
          "type": "string"
        },
        "prefix": {
          "default": "",
          "title": "Prefix",
          "type": "string"
        },
        "secrets": {
          "title": "Secrets",
          "type": "integer"
        }
      },
      "required": [
        "vault",
        "mount",
        "secrets"
      ],
      "title": "EncryptedSource",
      "type": "object"
    },
    "Kdf": {
      "additionalProperties": false,
      "description": "How a passphrase becomes the key (RFC 9106 Argon2id).",
      "properties": {
        "name": {
          "const": "argon2id",
          "default": "argon2id",
          "title": "Name",
          "type": "string"
        },
        "salt": {
          "description": "base64, 16 bytes",
          "title": "Salt",
          "type": "string"
        },
        "memory_kib": {
          "maximum": 262144,
          "minimum": 8192,
          "title": "Memory Kib",
          "type": "integer"
        },
        "iterations": {
          "maximum": 10,
          "minimum": 1,
          "title": "Iterations",
          "type": "integer"
        },
        "lanes": {
          "maximum": 16,
          "minimum": 1,
          "title": "Lanes",
          "type": "integer"
        }
      },
      "required": [
        "salt",
        "memory_kib",
        "iterations",
        "lanes"
      ],
      "title": "Kdf",
      "type": "object"
    },
    "ExportDoc": {
      "additionalProperties": false,
      "description": "A secret-engine export with values. Treat it like the secrets themselves.",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "https://getlockstep.cloud/schemas/lockstep-export-v1.json",
          "title": "$Schema"
        },
        "format": {
          "const": "lockstep.secret-export",
          "default": "lockstep.secret-export",
          "title": "Format",
          "type": "string"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "tool": {
          "default": "",
          "title": "Tool",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ExportSource"
        },
        "rules": {
          "$ref": "#/$defs/ExportRules"
        },
        "secrets": {
          "items": {
            "$ref": "#/$defs/ExportSecret"
          },
          "title": "Secrets",
          "type": "array"
        },
        "skipped": {
          "$ref": "#/$defs/ExportSkipped"
        }
      },
      "required": [
        "created_at",
        "source",
        "secrets"
      ],
      "title": "Lockstep secret-engine export",
      "type": "object"
    },
    "EncryptedExport": {
      "additionalProperties": false,
      "description": "An encrypted export: open it with the one-time key shown when it was made, the\npassphrase it was made with, or an age identity for one of its recipients.",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "https://getlockstep.cloud/schemas/lockstep-export-v1.json",
          "title": "$Schema"
        },
        "format": {
          "const": "lockstep.secret-export.encrypted",
          "default": "lockstep.secret-export.encrypted",
          "title": "Format",
          "type": "string"
        },
        "version": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Version",
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "scheme": {
          "default": "key",
          "enum": [
            "key",
            "passphrase",
            "age"
          ],
          "title": "Scheme",
          "type": "string"
        },
        "cipher": {
          "default": "AES-256-GCM",
          "enum": [
            "AES-256-GCM",
            "age"
          ],
          "title": "Cipher",
          "type": "string"
        },
        "compression": {
          "default": "zlib",
          "enum": [
            "zlib",
            "none"
          ],
          "title": "Compression",
          "type": "string"
        },
        "kdf": {
          "anyOf": [
            {
              "$ref": "#/$defs/Kdf"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "scheme passphrase: how the key is derived"
        },
        "recipients": {
          "description": "scheme age: the age public keys it's for",
          "items": {
            "type": "string"
          },
          "title": "Recipients",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/EncryptedSource"
        },
        "nonce": {
          "default": "",
          "description": "base64, 12 bytes (not used by age)",
          "title": "Nonce",
          "type": "string"
        },
        "ciphertext": {
          "description": "base64: the zlib-compressed export, encrypted; for age, an armored age file of the plain export",
          "title": "Ciphertext",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "source",
        "ciphertext"
      ],
      "title": "Lockstep secret-engine export (encrypted)",
      "type": "object"
    }
  }
}
